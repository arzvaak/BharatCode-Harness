{
  "name": "@bharatcode/3d-toolkit",
  "version": "0.1.3",
  "description": "Editable Three.js and Babylon.js projects with native preview, render and export tools.",
  "type": "module",
  "license": "MIT",
  "exports": {".": "./src/host.js", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["src", "lib", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {"test": "node --test test/*.test.mjs", "build": "node scripts/build.mjs"},
  "dependencies": {
    "three": "0.186.1",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "@react-three/rapier": "2.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0",
    "@babylonjs/serializers": "9.31.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "fflate": "0.8.2"
  },
  "engines": {"node": ">=24", "dsh": ">=0.2.0-rc.2 <0.3.0"},
  "peerDependencies":{"@deepseek-ai/dsh-tools":"0.2.0-rc.2"},
  "bundledDependencies":["three","@react-three/fiber","@react-three/drei","@react-three/rapier","react","react-dom","@babylonjs/core","@babylonjs/loaders","@babylonjs/serializers","esbuild","playwright-core","fflate"],
  "dsh": {"manifestVersion": 1, "engines":{"dsh":">=0.2.0-rc.2 <0.3.0"}, "bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "inject":["@deepseek-ai/dsh-client-ui-renderer","@deepseek-ai/dsh-client-ui-layout","@deepseek-ai/dsh-client-ui-sidebar"]}}
}
