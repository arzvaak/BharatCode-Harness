{
  "compilerOptions": {
    "declaration": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2023",
      "ESNext.Disposable",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "removeComments": true
  },
  "include": [
    "src/index.ts"
  ]
}
