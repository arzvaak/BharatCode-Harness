{
  "name": "dsh-deepread",
  "description": "English upstream DeepRead host engine for source extraction, evidence reports, long-document synthesis and model-free budget estimates.",
  "version": "1.0.1-bharatcode.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.host.json",
    "test": "node --test test/runtime.test.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "^24.13.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2"
  },
  "keywords": [
    "dsh-plugin",
    "research",
    "reading",
    "pdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiehuan123/dsh-deepread.git"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
